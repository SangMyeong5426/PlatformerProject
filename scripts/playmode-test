#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Unity 창 없이 플레이모드 테스트를 돌린다.

무엇을 하나
  Unity 를 배치모드로 띄워 Assets/Tests/ 의 플레이모드 테스트를 실행하고 결과를 읽는다.
  게임 루프가 실제로 도는 진짜 실행이다 - 코루틴, WaitForSeconds, 씬 로드가 동작한다.

왜 필요한가
  이 저장소의 다른 검증 도구 둘은 소스를 읽을 뿐 실행하지 않는다.

    scripts/compile-check       컴파일이 되는가
    scripts/boss-pattern-diff   패턴 연산 시퀀스가 같은가

  둘 다 통과했는데 실행하면 Awake 에서 예외가 나던 결함이 실제로 있었다(영어 로케일
  봉인 대화). 그 빈틈을 메운다.

전제
  **Unity 를 닫아야 한다.** 배치모드가 프로젝트를 독점하므로 에디터가 켜져 있으면
  실행되지 않는다. 이 스크립트가 먼저 확인하고 알려준다.

한계
  - 키 입력을 만들어낼 수 없다. activeInputHandler 가 구 Input Manager 라
    Input.GetKeyDown 을 코드로 흉내낼 방법이 없다
  - 화면에 무엇이 그려지는지는 보지 않는다. 상태값만 본다

  근거와 대안 검토는 docs/adr/0005-batchmode-playmode-tests.md 에 있다.

배치모드가 막히면
  라이선스가 배치모드에서 안 풀리는 경우가 있다(Personal 라이선스 + 토큰 미캐시).
  그때는 에디터의 Test Runner 창에서 돌린다. Assets/Tests/Editor/TestResultWriter.cs 가
  그 결과를 Logs/playmode-results.xml 에 남기므로 --last 로 같은 형식으로 읽을 수 있다.

사용법
  python scripts/playmode-test
  python scripts/playmode-test --filter Wind      이름에 Wind 가 든 테스트만
  python scripts/playmode-test --log              실패해도 Unity 로그 전체를 출력
  python scripts/playmode-test --last             마지막 실행 결과만 다시 읽는다
"""
import argparse
import io
import os
import subprocess
import sys
import tempfile
import time
import xml.etree.ElementTree as ET

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
UNITY_VERSION = "2021.3.0f1"
EDITOR_RESULTS = os.path.join("Logs", "playmode-results.xml")
EDITOR_ROOTS = [
    r"C:\Program Files\Unity\Hub\Editor",
    r"C:\Program Files (x86)\Unity\Hub\Editor",
]


def find_unity_exe():
    for base in EDITOR_ROOTS:
        exe = os.path.join(base, UNITY_VERSION, "Editor", "Unity.exe")
        if os.path.exists(exe):
            return exe
    return None


def editor_is_open():
    """이 프로젝트를 연 Unity 에디터가 떠 있는지 본다.

    Library/ 의 잠금 파일을 보는 편이 정확하지만 Unity 가 비정상 종료하면 남아 있어서
    거짓 양성이 난다. 프로세스를 직접 본다.
    """
    try:
        out = subprocess.run(
            ["tasklist", "/FI", "IMAGENAME eq Unity.exe", "/FO", "CSV", "/NH"],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        text = out.stdout.decode("utf-8", "replace")
    except OSError:
        return False
    # AssetImportWorker 도 Unity.exe 다. 에디터 본체만 세려면 창 제목이 필요한데
    # tasklist 로는 안 나온다. 하나라도 떠 있으면 확인을 요청한다.
    return "Unity.exe" in text


def report(results_path):
    """NUnit3 결과 XML 을 읽어 사람이 볼 형태로 찍는다."""
    tree = ET.parse(results_path)
    run = tree.getroot()

    cases = list(run.iter("test-case"))
    passed = [c for c in cases if c.get("result") == "Passed"]
    failed = [c for c in cases if c.get("result") == "Failed"]
    skipped = [c for c in cases if c.get("result") not in ("Passed", "Failed")]

    for c in cases:
        mark = {"Passed": "PASS", "Failed": "FAIL"}.get(c.get("result"), "SKIP")
        print("  %-4s %s  (%ss)" % (mark, c.get("name"), c.get("duration", "?")[:5]))

    for c in failed:
        print("")
        print("  --- %s" % c.get("name"))
        failure = c.find("failure")
        if failure is not None:
            for tag in ("message", "stack-trace"):
                node = failure.find(tag)
                if node is not None and node.text:
                    for line in node.text.strip().split("\n"):
                        print("      " + line.rstrip())
    print("")
    print("성공 %d  실패 %d  건너뜀 %d" % (len(passed), len(failed), len(skipped)))
    return len(failed) == 0 and len(passed) > 0


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--filter", help="테스트 이름 필터")
    ap.add_argument("--log", action="store_true", help="Unity 로그 전체 출력")
    ap.add_argument("--last", action="store_true",
                    help="마지막 실행 결과(Logs/playmode-results.xml)만 다시 읽는다")
    args = ap.parse_args()

    for stream in (sys.stdout, sys.stderr):
        try:
            stream.reconfigure(encoding="utf-8")
        except (AttributeError, ValueError):
            pass

    if args.last:
        path = os.path.join(ROOT, EDITOR_RESULTS)
        if not os.path.exists(path):
            sys.stderr.write(
                "%s 가 없다. 에디터 Test Runner 로 한 번 돌리거나 배치모드로 실행한다\n"
                % EDITOR_RESULTS)
            return 2
        age = (time.time() - os.path.getmtime(path)) / 60.0
        print("%s (%.0f분 전 실행)" % (EDITOR_RESULTS, age))
        return 0 if report(path) else 1

    exe = find_unity_exe()
    if exe is None:
        sys.stderr.write("Unity %s 설치를 찾지 못했다. EDITOR_ROOTS 를 확인한다\n" % UNITY_VERSION)
        return 2

    if editor_is_open():
        sys.stderr.write(
            "Unity 가 실행 중이다. 배치모드는 프로젝트를 독점하므로 에디터를 닫아야 한다.\n"
            "  (AssetImportWorker 만 남은 경우도 있다. 작업 관리자에서 Unity.exe 를 확인한다)\n")
        return 2

    tmp = tempfile.mkdtemp(prefix="playmode-test-")
    results = os.path.join(tmp, "results.xml")
    log = os.path.join(tmp, "unity.log")

    cmd = [exe,
           "-batchmode",
           "-projectPath", ROOT,
           "-runTests",
           "-testPlatform", "PlayMode",
           "-testResults", results,
           "-logFile", log]
    if args.filter:
        cmd += ["-testFilter", args.filter]

    print("Unity 배치모드 실행 중... (첫 실행은 임포트 때문에 몇 분 걸린다)")
    proc = subprocess.run(cmd)

    if not os.path.exists(results):
        sys.stderr.write("결과 파일이 나오지 않았다. Unity 종료 코드 %d\n" % proc.returncode)
        sys.stderr.write("로그: %s\n" % log)
        if os.path.exists(log):
            text = io.open(log, encoding="utf-8", errors="replace").read()
            tail = text if args.log else "\n".join(text.split("\n")[-60:])
            sys.stderr.write(tail + "\n")
        return 3

    ok = report(results)

    if args.log and os.path.exists(log):
        print("")
        print("--- Unity 로그 ---")
        print(io.open(log, encoding="utf-8", errors="replace").read())
    elif not ok:
        print("")
        print("Unity 로그: %s" % log)

    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
